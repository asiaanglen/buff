{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buff",
  "account_id": "8447d2f9fbf3e27878055f12eab784f8",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "keep_vars": true,
  "vars": { "USAGE_SAMPLE_RATE": "0.05" },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/*",
      "/approvals/*",
      "/connections",
      "/coach",
      "/coach/*",
      "/usage",
      "/usage/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buff",
      "database_id": "50c0fabf-368b-4cba-bf6c-138c861ec637",
      "migrations_dir": "migrations",
    },
  ],
}
